{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "category": {
      "type": "string",
      "enum": [
        "Process",
        "References",
        "Experiments",
        "Studio notes"
      ]
    },
    "excerpt": {
      "type": "string"
    },
    "coverImage": {
      "type": "string",
      "minLength": 1
    },
    "coverAlt": {
      "type": "string"
    },
    "readingTime": {
      "type": "string"
    },
    "relatedFilm": {
      "type": "string"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "seoDescription": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "date",
    "category",
    "excerpt",
    "coverImage",
    "coverAlt",
    "readingTime"
  ]
}