---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FilmArchive from "../../components/FilmArchive.astro";

const films = (await getCollection("films")).sort((a, b) => b.data.year - a.data.year);
---
<BaseLayout title="Films — Little Wild Films" description="Selected films and visual experiments by Little Wild Films.">
  <main class="archive-page section-dark">
    <header class="archive-header">
      <div class="inner-page-kicker">[ 01 — Selected work ]</div>
      <h1>Worlds in<br /><em>the making.</em></h1>
      <p>The moving-image archive of animated shorts, live-action studies, and visual experiments made between intuition and invention.</p>
    </header>
    <FilmArchive films={films} />
  </main>
</BaseLayout>
