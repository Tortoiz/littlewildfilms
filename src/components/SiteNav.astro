---
const logoSrc = "/manus-storage/logo-little-wild-films_ab28ea8f.png";
const currentPath = Astro.url.pathname;
const isCurrent = (path: string) => currentPath === path || currentPath.startsWith(`${path}/`);
const navItems = [
  { label: "Films", href: "/films" },
  { label: "Studio", href: "/studio" },
  { label: "Journal", href: "/journal" },
];
---
<header class="site-nav">
  <a class="brand-lockup" href="/" aria-label="Little Wild Films home"><img src={logoSrc} alt="Little Wild Films logo" /><span>Little Wild<br />Films</span></a>
  <nav class="desktop-nav" aria-label="Main navigation">
    {navItems.map((item) => <a class:list={{ "is-current": isCurrent(item.href) }} href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>)}
  </nav>
  <a class:list={{ "nav-contact": true, "is-current": isCurrent("/contact") }} href="/contact" aria-current={isCurrent("/contact") ? "page" : undefined}>Start a conversation <span aria-hidden="true">↗</span></a>
  <details class="mobile-menu">
    <summary aria-label="Open navigation"><span class="menu-glyph" aria-hidden="true">☰</span></summary>
    <nav class="mobile-nav" aria-label="Mobile navigation">
      {navItems.map((item) => <a class:list={{ "is-current": isCurrent(item.href) }} href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>)}
      <a class:list={{ "is-current": isCurrent("/contact") }} href="/contact" aria-current={isCurrent("/contact") ? "page" : undefined}>Contact <span aria-hidden="true">↗</span></a>
    </nav>
  </details>
</header>
