---
import BaseLayout from "../layouts/BaseLayout.astro";

const heroSrc = "/manus-storage/hero-film-still_04dfca7c.jpg";
const cardSrc = "/manus-storage/film-card-still_16d5ff5a.jpg";
---
<BaseLayout>
  <main class="site-shell">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="hero-image" role="img" aria-label="A tiny warm light over a mossy valley at blue hour" style={`background-image: url('${heroSrc}')`}></div>
      <div class="hero-scrim"></div>
      <div class="hero-grid"></div>
      <div class="hero-meta meta-left">Independent production house<br />Est. 2026 · India</div>
      <div class="hero-meta meta-right">Scroll to enter <span aria-hidden="true">↓</span></div>
      <div class="hero-copy">
        <p class="eyebrow"><span class="signal-dot"></span> Animation · live action · almost-real cinema</p>
        <h1 id="hero-title">Stories from<br /><em>the edge</em> of what’s possible.</h1>
        <p class="hero-subtitle">Little Wild Films is an independent studio making animated, live-action, and AI-assisted films for strange times.</p>
        <a class="text-link" href="#films">Enter the films <span aria-hidden="true">↗</span></a>
      </div>
      <div class="hero-mark">01 / 04</div>
    </section>

    <section class="intro section-light" id="studio" aria-labelledby="intro-title">
      <div class="section-kicker">[ 01 — The studio ]</div>
      <div class="intro-content">
        <h2 id="intro-title">Small films.<br /><span>Wild imaginations.</span></h2>
        <div class="intro-body">
          <p>We are a small independent studio with a large sense of possibility. We build intimate worlds, strange futures, and ordinary moments that become magical when you look at them long enough.</p>
          <p class="muted-copy">AI is part of the process — not the point. The point is the feeling a film leaves behind.</p>
          <a class="dark-link" href="#journal">Read the studio notes <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section class="films section-dark" id="films" aria-labelledby="films-title">
      <div class="section-heading">
        <div class="section-kicker">[ 02 — Selected work ]</div>
        <h2 id="films-title">Worlds in<br /><em>the making.</em></h2>
        <p>Short films, animated worlds, and visual experiments made between intuition and invention.</p>
      </div>
      <div class="film-list">
        <article class="film-item large-film">
          <a class="film-placeholder feature-placeholder" href="/films/mosslight" aria-label="Open Mosslight project page">
            <div class="placeholder-signal">visual / 01</div>
            <div class="film-title-overlay"><span>Film 01</span><h3>Mosslight</h3></div>
          </a>
          <div class="film-caption"><div><h3>Mosslight</h3><p>A forest remembers the people who pass through it.</p></div><span>Animated short · In development</span></div>
        </article>
        <article class="film-item card-film">
          <a class="film-placeholder card-placeholder" href="/films/after-the-rain" aria-label="Open After the Rain project page" style={`background-image: url('${cardSrc}')`}>
            <div class="placeholder-signal">visual / 02</div>
            <span class="play-button" aria-hidden="true">▶</span>
            <div class="film-title-overlay"><span>Film 02</span><h3>After the Rain</h3></div>
          </a>
          <div class="film-caption"><div><h3>After the Rain</h3><p>A city becomes strange when the last light goes out.</p></div><span>Live-action study · Coming soon</span></div>
        </article>
      </div>
      <div class="film-footer"><span>Archive 01—02</span><span>More films arriving soon <span aria-hidden="true">↗</span></span></div>
    </section>

    <section class="manifesto" id="journal" aria-labelledby="manifesto-title">
      <div class="manifesto-orbit orbit-one"></div>
      <div class="manifesto-orbit orbit-two"></div>
      <div class="section-kicker">[ 03 — A working belief ]</div>
      <h2 id="manifesto-title">Technology expands<br />the frame. <em>Taste gives it meaning.</em></h2>
      <div class="manifesto-bottom"><span>Field notes · 001</span><p>We believe a film can be small and still feel enormous. We believe new tools deserve old-fashioned attention.</p></div>
    </section>

    <section class="contact section-light" id="contact" aria-labelledby="contact-title">
      <div class="section-kicker">[ 04 — Make something ]</div>
      <div class="contact-layout">
        <div><h2 id="contact-title">Have a story<br /><em>looking for a world?</em></h2><p>We are open to films, collaborations, music videos, visual development, and carefully chosen commissions.</p></div>
        <a class="contact-button" href="mailto:hello@littlewildfilms.com">Start a conversation <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
</BaseLayout>
